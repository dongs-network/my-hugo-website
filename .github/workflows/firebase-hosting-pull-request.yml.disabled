name: Deploy to Firebase Hosting on PR

on:
  pull_request:

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

jobs:
  build_and_preview:
    if: ${{ github.event.pull_request.head.repo.full_name == github.repository }}
    runs-on: ubuntu-latest

    steps:
      - name: Check out code
        uses: actions/checkout@v4
        with:
          submodules: true
          fetch-depth: 0

      - name: Hugo setup
        uses: peaceiris/actions-hugo@v2.6.0
        with:
          hugo-version: "0.162.1"
          extended: true

      # Added this — clear old Blowfish/Hugo module cache
      - name: Clear Hugo module cache
        run: hugo mod clean

      # Added this — force update Blowfish + modules
      - name: Update Hugo modules
        run: hugo mod get -u

      # (Optional but recommended)
      - name: Check Hugo version
        run: hugo version

      - name: Build with Hugo
        env:
          HUGO_ENVIRONMENT: production
          HUGO_ENV: production
        run: hugo -E -F --minify -d public

      - name: Deploy PR Preview to Firebase Hosting
        uses: w9jds/firebase-action@v2.2.0
        with:
          args: hosting:channel:deploy preview-${{ github.event.number }} --expires 30d
        env:
          FIREBASE_TOKEN: ${{ secrets.FIREBASE_TOKEN }}
